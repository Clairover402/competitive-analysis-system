# ============================================================
# 竞品分析多Agent协作系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ----------------------------------------------------------
# LLM — DeepSeek Chat API
# ----------------------------------------------------------
DEEPSEEK_API_KEY=competitive-analysis-system-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ----------------------------------------------------------
# Database — PostgreSQL + pgvector
# ----------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=competitive_analysis
PG_USER=postgres
PG_PASSWORD=competitive_analysis_pwd

# ----------------------------------------------------------
# Embedding — BGE-M3 (1024维)
# ----------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ----------------------------------------------------------
# Reranker — BGE-reranker-v2-m3
# ----------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ----------------------------------------------------------
# 采集配额 — Collector（2026-10-16 新增）
# ----------------------------------------------------------
# 每竞品最多抓取的页面数。默认 8（与原硬编码常量一致）。
# 是否调大取决于 Collector 的「采集漏斗」日志：
#   若「候选池」大而「配额选中」小 → 配额是瓶颈，可调到 12~15；
#   若「候选池」本身就小       → 瓶颈在上游（搜索候选不足 / 过滤过严），调配额无效。
PER_COMPETITOR_PAGE_CAP=8
# 每个 URL 最多保留几条 chunk 进候选池。默认 1（= 与原有行为逐字节等价）。
# 实测每页平均产出 2.7 个 chunk，调到 2~3 可显著提升候选多样性；代价是 token 上升。
CHUNKS_PER_URL=1

# ----------------------------------------------------------
# 检索阈值 — Analyzer（2026-10-16 新增，防「检索退化」）
# ----------------------------------------------------------
# 向量检索 top_k。它是**绝对值**，而检索池是「按 task 的全竞品混池」。
# 当池子 < top_k 时该层退化为「全量返回」→ 维度区分度归零（Analyzer 会打 WARN）。
# 建议：池子规模（看 Collector 的「最终落库规模」日志）应 ≥ 3 × 本值。
VECTOR_SEARCH_TOP_K=60
# 精排 top_k。候选池 ≤ 本值时精排只排序不截断，维度区分度无法体现在 contexts 集合上。
RERANK_TOP_K=15

# ----------------------------------------------------------
# 任务规模上限 — 入口校验（2026-10-21 新增）
# ----------------------------------------------------------
# 单次任务最多几个竞品 / 几个维度，超出时 POST /api/tasks 直接 400。
# 【为什么要有上限】VECTOR_SEARCH_TOP_K 是**绝对值**，而检索池按 task 混池：
#   竞品数一多，每个竞品分到的配额就被摊薄。实测 8 竞品 / 612 chunk 的任务里，
#   某竞品在单一维度 0/60 → 那格只能写 [数据不足]，而报告**看起来是完整的**。
# 【调大前先确认】调大这两个值，要同步调大 VECTOR_SEARCH_TOP_K（经验：≥ 竞品数 × 15）。
MAX_COMPETITORS=4
MAX_DIMENSIONS=4

# ----------------------------------------------------------
# RAGAS 评估运行参数（2026-10-16 新增，防「超时静默丢分」）
# ----------------------------------------------------------
# 单个 (样本, 指标) 作业的超时秒数。ragas 默认 180s，但 context_precision 对
# retrieved_contexts 是**串行**逐条判定的（12 条 contexts = 12 次 judge 调用），
# 长 contexts 样本跑不完 → 整格 NaN（实测 `钉钉@功能 cp=NaN` + Job[12]: TimeoutError）。
# 600 = 留足余量；正常样本远用不到。同时也是底层 HTTP 请求的 request_timeout。
RAGAS_EVAL_TIMEOUT=600
# 并发作业数上限。ragas 默认 16（4 样本 × 4 指标 = 16 个作业同时在打 judge）
# 容易触发上游限流 → 重试 → 更慢 → 反而更容易撞超时。降到 8 换稳定。
RAGAS_EVAL_MAX_WORKERS=8
# 同一批样本重复跑几轮（>1 时每个 (样本,指标) 取中位数）。
# 动机：n=4 时 judge 方差大于指标效应（同输入两轮 cr 可差 0.5），单轮不可读。
# ⚠️ 成本线性 ×N，默认 1；压方差时用 CLI `--repeat 3` 显式开启。
RAGAS_EVAL_REPEAT=1

# ----------------------------------------------------------
# Auth — JWT
# ----------------------------------------------------------
JWT_SECRET=competitive-analysis-jwt-secret-change-in-production
JWT_EXPIRE_HOURS=24

# ----------------------------------------------------------
# Limits — 并发 & 频控
# ----------------------------------------------------------
MAX_CONCURRENT_COLLECTORS=3
MAX_ROUNDS_SUPERVISOR=10
TOKEN_BUCKET_CAPACITY=100
LLM_RPM_LIMIT=60