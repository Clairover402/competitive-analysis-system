# 项目工作区数据（记忆/Agent 笔记，不入代码库）
.workbuddy/

# Golden 回归产物（每次跑归档在 phase_report/runs/，不入库；
# 里程碑 baseline 想留档可 git add -f 单独提交）
phase_report/

# 评估产物（四类评估共用，位置由 src/evaluation/common/paths.py 决定）。
# 全部是派生产物：SUMMARY.md / runs/ / trend.json / golden_v1.jsonl 都能从
# 代码与题库（cases.py / dataset.py）重建，所以整目录不入库。
# ⚠️ 别在这里放「只此一份」的东西 —— clone 下来 evaluation_reports/ 是空的。
evaluation_reports/

# 手绘图导出产物（源 HTML 与 PNG 都是派生物，随时可重画）
generated-images/
