    {
      "type": "barchart",
      "title": "采集漏斗（时间窗内合计）",
      "description": "搜索命中 → 发起抓取 → 抓到正文 → 入库 chunk。哪一段塌了一眼可见。",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 57
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT stage, n FROM (\n  SELECT 1 AS ord, '① 搜索命中' AS stage, COALESCE(SUM(funnel_search), 0)::int AS n\n    FROM trajectory_metrics WHERE funnel_search IS NOT NULL AND $__timeFilter(computed_at)\n  UNION ALL\n  SELECT 2, '② 发起抓取', COALESCE(SUM(funnel_fetch), 0)::int\n    FROM trajectory_metrics WHERE funnel_fetch IS NOT NULL AND $__timeFilter(computed_at)\n  UNION ALL\n  SELECT 3, '③ 抓到正文', COALESCE(SUM(funnel_pages), 0)::int\n    FROM trajectory_metrics WHERE funnel_pages IS NOT NULL AND $__timeFilter(computed_at)\n  UNION ALL\n  SELECT 4, '④ 入库 chunk', COALESCE(SUM(funnel_chunks), 0)::int\n    FROM trajectory_metrics WHERE funnel_chunks IS NOT NULL AND $__timeFilter(computed_at)\n) t ORDER BY ord",
          "editorMode": "code"
        }
      ],
      "options": {
        "xField": "stage",
        "orientation": "vertical",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "搜索空结果率趋势",
      "description": "按天任务等权平均（一行一任务），与 CLI 的 statistics.fmean 口径一致。",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 65
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT $__timeGroup(computed_at, '1d') AS \"time\",\n       ROUND((AVG(search_empty_rate) * 100)::numeric, 1) AS \"空结果率%\"\nFROM trajectory_metrics\nWHERE search_empty_rate IS NOT NULL AND $__timeFilter(computed_at)\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "抓取失败次数（按错误类型堆叠）",
      "description": "只看「抛异常」的失败；timeout / 403 / SSL / 连接失败 / 其他。",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 65
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT $__timeGroup(computed_at, '1d') AS \"time\",\n       COALESCE(SUM((fetch_fail_detail->>'403')::int), 0)  AS \"403\",\n       COALESCE(SUM((fetch_fail_detail->>'timeout')::int), 0) AS \"超时\",\n       COALESCE(SUM((fetch_fail_detail->>'ssl')::int), 0)  AS \"SSL\",\n       COALESCE(SUM((fetch_fail_detail->>'连接失败')::int), 0) AS \"连接失败\",\n       COALESCE(SUM((fetch_fail_detail->>'其他')::int), 0) AS \"其他\"\nFROM trajectory_metrics\nWHERE fetch_fail_detail IS NOT NULL AND $__timeFilter(computed_at)\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "rerank 区分度趋势",
      "description": "top1 - median，越接近 0 越说明精排分不开。灰色虚线是 0.05 参考线，不触发告警。",
      "gridPos": {
