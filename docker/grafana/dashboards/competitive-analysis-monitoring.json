    {
      "type": "timeseries",
      "title": "评估总分趋势（eval_results）",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT $__timeGroup(created_at,'1d') AS time, eval_type AS metric, ROUND(AVG(overall_score)::numeric,3) AS value FROM eval_results WHERE overall_score IS NOT NULL AND $__timeFilter(created_at) GROUP BY 1,2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "timeseries",
      "title": "RAGAS 单指标趋势",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT $__timeGroup(m.created_at,'1d') AS time, m.metric_name AS metric, ROUND(AVG(m.score)::numeric,3) AS value FROM eval_metric_scores m JOIN eval_results e ON m.eval_id = e.id WHERE m.metric_name IN ('faithfulness','context_precision','answer_relevancy','recall_hit_rate','source_coverage') AND $__timeFilter(m.created_at) GROUP BY 1,2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Judge 五维评分趋势",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT $__timeGroup(m.created_at,'1d') AS time, m.metric_name AS metric, ROUND(AVG(m.score)::numeric,1) AS value FROM eval_metric_scores m JOIN eval_results e ON m.eval_id = e.id WHERE e.eval_type = 'judge' AND $__timeFilter(m.created_at) GROUP BY 1,2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100
        }
