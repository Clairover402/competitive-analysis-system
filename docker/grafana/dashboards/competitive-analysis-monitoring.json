          },
          "format": "table",
          "rawSql": "SELECT $__timeGroup(computed_at, '1d') AS \"time\",\n       ROUND(AVG(rerank_gap)::numeric, 4) AS \"区分度\",\n       0.05 AS \"参考线 0.05\"\nFROM trajectory_metrics\nWHERE rerank_gap IS NOT NULL AND $__timeFilter(computed_at)\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
