    {
      "type": "piechart",
      "title": "终止原因分布",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 57
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT\n  count(*) FILTER (WHERE termination = 'finish')      AS \"finish\",\n  count(*) FILTER (WHERE termination = 'max_rounds')  AS \"max_rounds\",\n  count(*) FILTER (WHERE termination = 'incomplete')  AS \"incomplete\",\n  count(*) FILTER (WHERE termination = 'forced_finish') AS \"forced_finish\",\n  count(*) FILTER (WHERE termination = 'json_error')    AS \"json_error\"\nFROM trajectory_metrics\nWHERE termination <> 'n/a' AND $__timeFilter(computed_at)",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
