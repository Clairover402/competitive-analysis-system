    {
      "type": "table",
      "title": "最近评估记录（eval_results）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "datasource": {
        "type": "postgres",
        "uid": "cas-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cas-postgres"
          },
          "format": "table",
          "rawSql": "SELECT e.created_at AS 时间, e.eval_type AS 类型, e.overall_score AS 总分, e.gate AS 门禁, e.is_golden AS 是否Golden, (SELECT string_agg(m.metric_name || '=' || m.score, ', ')  FROM eval_metric_scores m WHERE m.eval_id = e.id) AS 指标明细 FROM eval_results e ORDER BY e.created_at DESC LIMIT 20",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
